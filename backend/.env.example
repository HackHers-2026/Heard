# ---- Core ----
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./heard.db
# Supabase Postgres (swap in for prod):
# DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.ytmrxkzczjsiorfcsbmc.supabase.co:5432/postgres

# Comma-separated list of allowed origins (web app + extension)
CORS_ORIGINS=http://localhost:5173,chrome-extension://YOUR_EXTENSION_ID

# ---- Supabase (auth + prod DB) ----
# Project: https://supabase.com/dashboard/project/ytmrxkzczjsiorfcsbmc
SUPABASE_URL=https://ytmrxkzczjsiorfcsbmc.supabase.co
# Used to validate user tokens via the Supabase Auth server (/auth/v1/user).
# Dashboard → Settings → API → Project API keys → publishable/anon key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_KEY=          # Dashboard → Settings → API → service_role key
# Legacy shared JWT secret — no longer required (kept for backward compatibility).
# SUPABASE_JWT_SECRET=

# ---- Google Gemini (live feedback + scoring + summaries) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- ElevenLabs (speech-to-text transcription) ----
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
# Realtime streaming STT used by the Chrome extension side panel.
ELEVENLABS_REALTIME_MODEL=scribe_v2_realtime
ELEVENLABS_STT_WS_URL=wss://api.elevenlabs.io/v1/speech-to-text/realtime

# ---- Backboard (stateful coaching layer around Gemini) ----
# Dashboard → Settings → API Keys. Leave blank to run coaching in stub mode.
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
# Which Google/Gemini model Backboard routes live coaching through. List the
# current options with: curl $BACKBOARD_BASE_URL/models/provider/google -H "X-API-Key: $BACKBOARD_API_KEY"
BACKBOARD_GOOGLE_MODEL=gemini-2.5-flash

# ---- TigerData (TimescaleDB hypertables — analytics) ----
# postgres://tsdbadmin:<password>@vcl1v2nob6.v8soaqs7mr.tsdb.cloud.timescale.com:32386/tsdb?sslmode=require
TIGERDATA_URL=postgres://tsdbadmin@vcl1v2nob6.v8soaqs7mr.tsdb.cloud.timescale.com:32386/tsdb?sslmode=require

# ---- Auth0 (LinkedIn OAuth — stretch) ----
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.heard.app
