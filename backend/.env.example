# ---- Core ----
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./heard.db

# Comma-separated list of allowed origins (web app + extension)
CORS_ORIGINS=http://localhost:5173,chrome-extension://YOUR_EXTENSION_ID

# ---- Google Gemini (live feedback + scoring + summaries) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- ElevenLabs (speech-to-text transcription) ----
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1

# ---- Backboard (memory layer for Gemini conversations) ----
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://api.backboard.io

# ---- TigerTable (structured data / analytics integration) ----
TIGERTABLE_API_KEY=
TIGERTABLE_BASE_URL=https://api.tigertable.com
