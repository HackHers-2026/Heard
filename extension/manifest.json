{
  "manifest_version": 3,
  "name": "Heard — Live Pitch Coach",
  "version": "0.1.0",
  "description": "A sidebar that records your speech and transcribes it live so you can practice being heard.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "http://localhost:8000/*",
    "ws://localhost:8000/*"
  ],
  "action": {
    "default_title": "Open Heard"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
